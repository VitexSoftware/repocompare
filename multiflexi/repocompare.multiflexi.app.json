{
  "$schema": "https://raw.githubusercontent.com/VitexSoftware/php-vitexsoftware-multiflexi-core/refs/heads/main/schema/application.json",
  "schemaVersion": "3.3.0",
  "version": "0.1.0",
  "uuid": "6e26be00-7099-43c2-99c8-8281ec4c3d21",
  "name": {
    "en": "RepoCompare",
    "cs": "RepoCompare"
  },
  "description": {
    "en": "Compare Debian package lists and versions between two APT repositories",
    "cs": "Porovnání seznamů a verzí Debian balíčků mezi dvěma APT repozitáři"
  },
  "tags": [
    "Debian",
    "Repo",
    "Compare"
  ],
  "requirements": [],
  "homepage": "https://github.com/VitexSoftware/repocompare",
  "executable": "repocompare",
  "environment": {
    "REPO_A": {
      "type": "url",
      "description": {"en": "Base URL for repo A", "cs": "Základní URL pro repozitář A"},
      "defval": "https://repo.vitexsoftware.com/",
      "required": false,
      "category": "Other"
    },
    "REPO_B": {
      "type": "url",
      "description": {"en": "Base URL for repo B", "cs": "Základní URL pro repozitář B"},
      "defval": "https://repo.multiflexi.eu/",
      "required": false,
      "category": "Other"
    },
    "DIST": {
      "type": "string",
      "description": {"en": "Debian distribution codename (e.g. bookworm)", "cs": "Kódový název Debian distribuce (např. bookworm)"},
      "defval": "bookworm",
      "required": false,
      "category": "Behavior"
    },
    "COMPONENT": {
      "type": "string",
      "description": {"en": "Repository component (e.g. main)", "cs": "Komponenta repozitáře (např. main)"},
      "defval": "main",
      "required": false,
      "category": "Behavior"
    },
    "ARCH": {
      "type": "string",
      "description": {"en": "Target architecture (e.g. amd64)", "cs": "Cílová architektura (např. amd64)"},
      "defval": "amd64",
      "required": false,
      "category": "Behavior"
    },
    "RESULT_FILE": {
      "type": "string",
      "description": {"en": "Path to file where JSON result is saved (stdout if empty)", "cs": "Cesta k souboru pro uložení JSON výstupu (prázdné = stdout)"},
      "defval": "",
      "required": false,
      "category": "Behavior"
    },
    "REPOCOMPARE_DISTS": {
      "type": "string",
      "description": {"en": "Space or comma-separated list of distribution codenames to compare (used by Zabbix LLD discovery)", "cs": "Mezerami nebo čárkami oddělený seznam kódových názvů distribucí pro porovnání (používá Zabbix LLD discovery)"},
      "defval": "bookworm trixie forky jammy noble raccoon",
      "required": false,
      "category": "Behavior"
    }
  }
}
